cabal-version:      3.0
name:               bd2-state-migrator
version:            0.1.0.0
synopsis:           Pure validation and migration kernel for BD2 player state
license:            LicenseRef-BD2-ARR
build-type:         Custom

custom-setup
  setup-depends:
      base >=4.18 && <4.19
    , Cabal >=3.11 && <3.16
    , proto-lens-setup >=0.4 && <0.5

common warnings
  default-language: GHC2021
  default-extensions: DerivingStrategies
  ghc-options:      -Wall -Wcompat -Widentities -Werror
  build-tool-depends:
      proto-lens-protoc:proto-lens-protoc
  build-depends:
      base >=4.18 && <4.19
    , bytestring >=0.11 && <0.12
    , containers >=0.6 && <0.7
    , lens-family >=2.1 && <2.2
    , lens-family-core >=2.1 && <2.2
    , proto-lens >=0.7 && <0.8
    , proto-lens-runtime >=0.7 && <0.8
    , text >=2.0 && <2.1

library
  import:           warnings
  hs-source-dirs:   src
  exposed-modules:
      BD2.State.Domain
      BD2.State.Framing
      BD2.State.Migrate.V1ToV2
      BD2.State.Repair.DuplicateCharacters
      BD2.State.Repair.NextIndices
      BD2.State.Repair.StepUpProgress
      BD2.State.Repair.GachaProgress
      BD2.State.Repair.CostumeOverflow
      BD2.State.Repair.Pipeline
      BD2.State.Validate
      Proto.Bd2.State.Control.V1.Control
      Proto.Bd2.State.Control.V1.Control_Fields
      Proto.Bd2.State.Control.V2.Control
      Proto.Bd2.State.Control.V2.Control_Fields
      Proto.Bd2.State.V1.State
      Proto.Bd2.State.V1.State_Fields
      Proto.Bd2.State.V2.State
      Proto.Bd2.State.V2.State_Fields
  autogen-modules:
      Proto.Bd2.State.Control.V1.Control
      Proto.Bd2.State.Control.V1.Control_Fields
      Proto.Bd2.State.Control.V2.Control
      Proto.Bd2.State.Control.V2.Control_Fields
      Proto.Bd2.State.V1.State
      Proto.Bd2.State.V1.State_Fields
      Proto.Bd2.State.V2.State
      Proto.Bd2.State.V2.State_Fields

executable bd2-state
  import:           warnings
  hs-source-dirs:   app
  main-is:          Main.hs
  build-depends:
      bd2-state-migrator

test-suite state-migrator-test
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  build-depends:
      bd2-state-migrator
    , QuickCheck >=2.16 && <2.19
