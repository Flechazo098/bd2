[Unit]
Description=Switch bd2server to the requested immutable image
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
Environment=BD2_DATA_DIR=/opt/bd2/data BD2_SOURCE_DIR=/opt/bd2/src BD2_COMPOSE_DIR=/opt/server-infra/bd2
Environment=BD2_GIT_REMOTE_URL=https://git.sighs.cc/Flechazo/bd2
ExecStart=/opt/bd2/bd2-docker-update.sh
# Builds can exceed the default oneshot timeout. flock also covers manual runs.
TimeoutStartSec=30min
TimeoutStopSec=30
Restart=no
