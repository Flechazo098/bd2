[Unit]
Description=Switch bd2server to the requested immutable image
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/opt/bd2/bd2-docker-update.sh
# Builds can exceed the default oneshot timeout. flock also covers manual runs.
TimeoutStartSec=30min
TimeoutStopSec=30
Restart=no
