# Install both units in /etc/systemd/system and adjust all deployment paths.
# systemctl daemon-reload && systemctl enable --now bd2-docker-update.path
[Unit]
Description=Watch for bd2server image update requests

[Path]
# PathExists catches atomic request renames and requests left during downtime.
# The helper claims and consumes requests, including every failed handoff.
PathExists=/opt/bd2/data/updates/docker-request.json
PathExists=/opt/bd2/data/updates/docker-request.processing.json
Unit=bd2-docker-update.service

[Install]
WantedBy=multi-user.target
