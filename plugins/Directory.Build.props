<Project>
  <!-- Shared repository settings. Machine paths belong in the local import. -->
  <PropertyGroup>
    <BD2PluginsDir>$(MSBuildThisFileDirectory)</BD2PluginsDir>
    <BD2RepositoryDir>$([System.IO.Path]::GetFullPath('$(BD2PluginsDir)..'))/</BD2RepositoryDir>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>8.0-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
  <Import Project="$(BD2PluginsDir)Directory.Build.local.props" Condition="Exists('$(BD2PluginsDir)Directory.Build.local.props')" />
  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == '' and '$(MSBuildProjectName)' == 'CaptureEnvironment' and '$(BD2CaptureGameDir)' != ''">$(BD2CaptureGameDir)</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">$(BD2LocalGameDir)</GameDir>
    <BD2ManagedDir Condition="'$(BD2ManagedDir)' == '' and '$(GameDir)' != ''">$(GameDir)/BrownDust II_Data/Managed</BD2ManagedDir>
    <BD2BepInExDir Condition="'$(BD2BepInExDir)' == '' and '$(GameDir)' != ''">$(GameDir)/BepInEx</BD2BepInExDir>
    <BD2VersionConfig Condition="'$(BD2VersionConfig)' == ''">$(BD2RepositoryDir)versions.json</BD2VersionConfig>
    <BD2SdkProject Condition="'$(BD2SdkProject)' == ''">$(BD2PluginsDir)GameSdk/GameSdk.csproj</BD2SdkProject>
    <BD2GameNamesProject Condition="'$(BD2GameNamesProject)' == ''">$(BD2PluginsDir)GameNames/GameNames.csproj</BD2GameNamesProject>
    <BD2SdkConfiguration Condition="'$(BD2SdkConfiguration)' == ''">Release</BD2SdkConfiguration>
    <BD2SdkTool Condition="'$(BD2SdkTool)' == ''">$(BD2PluginsDir)GameSdk/bin/$(BD2SdkConfiguration)/net8.0/GameSdk.dll</BD2SdkTool>
    <BD2SdkIntermediateFolder Condition="'$(BD2SdkIntermediateFolder)' == ''">game-sdk</BD2SdkIntermediateFolder>
    <BD2GameSdkCache Condition="'$(BD2GameSdkCache)' == ''">$(BD2_GAME_SDK_CACHE)</BD2GameSdkCache>
    <BD2GameSdkCache Condition="'$(BD2GameSdkCache)' == ''">$(BD2RepositoryDir).build/game-sdk</BD2GameSdkCache>
  </PropertyGroup>
</Project>
