<Project>
  <PropertyGroup>
    <BD2GameSdkEnabled Condition="'$(BD2GameSdkEnabled)' == ''">true</BD2GameSdkEnabled>
    <BD2GameSdkPackageRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../'))</BD2GameSdkPackageRoot>
    <BD2GameSdkCache Condition="'$(BD2GameSdkCache)' == ''">$([System.Environment]::GetFolderPath(SpecialFolder.LocalApplicationData))/BD2/GameSdk/navigation</BD2GameSdkCache>
  </PropertyGroup>
</Project>
