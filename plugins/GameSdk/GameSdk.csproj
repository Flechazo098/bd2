<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../PackageMetadata.props" />
  <PropertyGroup>
    <RootNamespace>BD2.GameSdk</RootNamespace>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ICSharpCode.Decompiler" Version="9.1.0.7988" />
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
    <Compile Include="../GameNames/NameTable.cs" Link="NameTable.cs" />
    <Compile Remove="samples/**/*.cs;Package/**/*.cs" />
    <EmbeddedResource Include="../GameNames/Mappings/names.json.gz" LogicalName="BD2.GameNames.names.json.gz" />
    <!-- Embed the complete generation source set so packaged tools fingerprint
         generation logic independently of CLI, validation and assembly metadata. -->
    <EmbeddedResource Include="Generation/**/*.cs" Exclude="Generation/NameGenerator.cs" LogicalName="BD2.GameSdk.Generation.%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="../GameNames/NameTable.cs" LogicalName="BD2.GameSdk.Generation.NameTable.cs" />
    <EmbeddedResource Include="Generation/NameGenerator.cs" LogicalName="BD2.GameSdk.Names.NameGenerator.cs" />
  </ItemGroup>
</Project>
