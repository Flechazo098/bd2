<Project>
  <PropertyGroup Condition="'$(BD2PreparedVersionDir)' != ''">
    <BD2GeneratedVersionSource>$(BD2PreparedVersionDir)/$(BD2PluginVersionKey).g.cs</BD2GeneratedVersionSource>
  </PropertyGroup>
  <PropertyGroup><BD2VersionSourceStamp>$(BD2GeneratedVersionSource).stamp</BD2VersionSourceStamp></PropertyGroup>
  <ItemGroup>
    <Compile Include="$(BD2GeneratedVersionSource)" />
    <Compile Include="$(BD2CompileInputsDir)/$(BD2PluginVersionKey).g.cs" Condition="'$(BD2CompileInputsDir)' != ''" />
    <BD2VersionGeneratorInput Include="$(BD2RepositoryDir)go/build/version_source.go;$(BD2RepositoryDir)go/internal/buildversion/**/*.go;$(BD2RepositoryDir)go/go.mod;$(BD2RepositoryDir)go/go.sum;$(MSBuildThisFileFullPath)" />
  </ItemGroup>
  <Target Name="CheckBD2VersionSource" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(BD2VersionConfig)')" Text="Missing repository version config: $(BD2VersionConfig)" />
    <Error Condition="'$(BD2PreparedVersionDir)' != '' and !Exists('$(BD2GeneratedVersionSource)')" Text="Missing prepared plugin version source: $(BD2GeneratedVersionSource)." />
    <Error Condition="'$(BD2CompileInputsDir)' != '' and !Exists('$(BD2CompileInputsDir)/$(BD2PluginVersionKey).g.cs')" Text="Missing plugin compilation fingerprint source: $(BD2CompileInputsDir)/$(BD2PluginVersionKey).g.cs." />
    <Delete Files="$(BD2VersionSourceStamp)" Condition="'$(BD2PreparedVersionDir)' == '' and !Exists('$(BD2GeneratedVersionSource)')" />
  </Target>
  <Target Name="GenerateBD2VersionSource" BeforeTargets="CoreCompile" DependsOnTargets="CheckBD2VersionSource" Condition="'$(BD2PreparedVersionDir)' == ''"
          Inputs="$(BD2VersionConfig);@(BD2VersionGeneratorInput)" Outputs="$(BD2VersionSourceStamp)">
    <Exec Condition="'$(OS)' == 'Windows_NT'" Command="call &quot;$(BD2RepositoryDir)bd2w.cmd&quot; version-source --config &quot;$(BD2VersionConfig)&quot; --output &quot;$(BD2GeneratedVersionSource)&quot; --plugin &quot;$(BD2PluginVersionKey)&quot;" />
    <Exec Condition="'$(OS)' != 'Windows_NT'" Command="&quot;$(BD2RepositoryDir)bd2w&quot; version-source --config &quot;$(BD2VersionConfig)&quot; --output &quot;$(BD2GeneratedVersionSource)&quot; --plugin &quot;$(BD2PluginVersionKey)&quot;" />
    <Touch Files="$(BD2VersionSourceStamp)" AlwaysCreate="true" />
  </Target>
</Project>
