<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>BD2LocalIdentity</AssemblyName>
    <RootNamespace>Bd2LocalIdentity</RootNamespace>
    <BD2PluginVersionKey>local_identity</BD2PluginVersionKey>
    <BD2ManagedDir Condition="'$(BD2ManagedDir)' == ''">$(GameDir)\BrownDust II_Data\Managed</BD2ManagedDir>
    <BD2BepInExDir Condition="'$(BD2BepInExDir)' == ''">$(GameDir)\BepInEx</BD2BepInExDir>
  </PropertyGroup>
  <Target Name="RequireGameDir" BeforeTargets="ResolveReferences" Condition="'$(GameDir)' == ''">
    <Error Text="GameDir is required. Build with -p:GameDir=&lt;local-client-directory&gt;." />
  </Target>
  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BD2BepInExDir)\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BD2BepInExDir)\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(BD2ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(BD2ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(BD2ManagedDir)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Import Project="..\VersionSource.targets" />
</Project>
