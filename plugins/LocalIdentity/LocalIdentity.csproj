<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>BD2LocalIdentity</AssemblyName>
    <RootNamespace>Bd2LocalIdentity</RootNamespace>
    <BD2UsesGameSdk>true</BD2UsesGameSdk>
    <BD2PluginVersionKey>local_identity</BD2PluginVersionKey>
    <BD2GameVersion>2.36.7</BD2GameVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Shared/ClientSettings.cs" Link="ClientSettings.cs" />
    <Reference Include="Google.Protobuf">
      <HintPath>$(BD2ManagedDir)/Google.Protobuf.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Compile Include="../Shared/ServerLoginPreferences.cs" Link="ServerLoginPreferences.cs" />
    <Reference Include="BepInEx">
      <HintPath>$(BD2BepInExDir)\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BD2BepInExDir)\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(BD2ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AIModule">
      <HintPath>$(BD2ManagedDir)\UnityEngine.AIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityAnalyticsModule">
      <HintPath>$(BD2ManagedDir)\UnityEngine.UnityAnalyticsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(BD2ManagedDir)\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(BD2ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(BD2ManagedDir)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
